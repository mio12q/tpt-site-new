# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical publication URL (defaults to https://therapistpsychologisttoday.com)
APP_URL="https://therapistpsychologisttoday.com"

# PostgreSQL Database Connections (Two-Role Least-Privilege Model):
# 1. DATABASE_MIGRATION_URL: Owner/migration role used ONLY to run `npm run db:migrate` and `npm run db:seed`
DATABASE_MIGRATION_URL="postgresql://tpt_migration_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/tpt_editorial_db?sslmode=require"
# 2. DATABASE_URL: Restricted application role (`tpt_app_user` — no superuser, no DDL, only SELECT/INSERT/UPDATE/DELETE)
DATABASE_URL="postgresql://tpt_app_user:CHANGE_ME_APP_PASSWORD@localhost:5432/tpt_editorial_db?sslmode=require"
PG_POOL_MAX="10"
PG_IDLE_TIMEOUT_MS="30000"
PG_CONNECT_TIMEOUT_MS="5000"

# Session & CSRF Signing Secret (minimum 32 bytes high-entropy random string)
SESSION_SECRET="CHANGE_ME_WITH_64_HEX_CHARACTER_CRYPTOGRAPHIC_SECRET"

# Admin Security Configuration (Production authenticates strictly against PostgreSQL `admin_users` seeded at runtime)
# For local development without DATABASE_URL, set ALLOW_DEMO_ADMIN="true" and ADMIN_PASSWORD_HASH in .env.local (ignored when NODE_ENV=production)
ALLOW_DEMO_ADMIN="false"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
ADMIN_TOTP_SECRET=""
ADMIN_IP_ALLOWLIST=""
TRUST_CLOUDFLARE="false"

# Optional Bot & Turnstile Verification
TURNSTILE_SECRET_KEY=""
IMAGE_SIGNING_SECRET="CHANGE_ME_IMAGE_HOTLINK_HMAC_SECRET"

# Preview Framing Override (keep "false" in production to enforce X-Frame-Options: DENY and frame-ancestors 'none')
ALLOW_PREVIEW_FRAMING="false"
